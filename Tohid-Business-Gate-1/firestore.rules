rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.uid == request.auth.uid 
        && data.email is string && data.email.size() <= 128
        && data.role in ['customer', 'admin']
        && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 64));
    }

    function isValidApplication(data) {
      return data.userId == request.auth.uid
        && data.status in ['draft', 'pending', 'approved', 'rejected']
        && data.structure is string && data.structure.size() <= 50
        && data.capital is number && data.capital >= 0
        && data.activities is list && data.activities.size() <= 20
        && data.tradeNames is list && data.tradeNames.size() <= 5
        && data.createdAt == (resource == null ? request.time : existing().createdAt);
    }

    function isValidMessage(data) {
      return data.senderId == request.auth.uid
        && data.text is string && data.text.size() > 0 && data.text.size() <= 2000
        && data.keys().hasAll(['senderId', 'text', 'createdAt'])
        && (data.createdAt == request.time || data.createdAt is timestamp);
    }

    // --- Match Groups ---

    // Dev connectivity / health document (optional doc in console)
    match /test/{docId} {
      allow get: if docId == 'connection';
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().role == 'customer';
      allow update: if isOwner(userId) && isValidUser(incoming()) 
                     && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'locale'])
                     || isAdmin();
    }

    match /applications/{appId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn() && isValidId(appId) && isValidApplication(incoming()) 
                     && incoming().status == 'draft';
      
      allow update: if isSignedIn() && isValidApplication(incoming()) && (
        // Action: User edits draft
        (isOwner(existing().userId) && existing().status == 'draft' 
         && incoming().diff(existing()).affectedKeys().hasOnly(['structure', 'jurisdiction', 'activities', 'tradeNames', 'capital', 'updatedAt'])) ||
        
        // Action: Submit for review
        (isOwner(existing().userId) && incoming().status == 'pending' && existing().status == 'draft'
         && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        
        // Action: Admin action
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
      );

      allow delete: if isAdmin() || (isOwner(existing().userId) && existing().status == 'draft');
    }

    match /chats/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      
      match /messages/{messageId} {
        allow list: if isSignedIn() && (isOwner(userId) || isAdmin());
        allow create: if isSignedIn() && isOwner(userId) && isValidMessage(incoming());
      }
    }

    match /admins/{adminId} {
       allow read: if isAdmin();
    }
  }
}
